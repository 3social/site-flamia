# ==========================================================================
# Flamia - configuracion Apache/LiteSpeed (Hostinger)
# Sube este archivo a public_html. En el Administrador de archivos de
# Hostinger activa "Mostrar archivos ocultos" para verlo.
# ==========================================================================

# --- 1. Una sola URL canonica: https://flamiagroup.com ---------------------
# Evita que Google indexe 4 versiones del mismo sitio (http/https, www/no-www)
# y reparta la autoridad entre ellas.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https, preservando el host: si algun dia una regla de aqui
  # alcanza a inmobiliaria.flamiagroup.com o ghl.flamiagroup.com, no debe
  # arrastrar su trafico al dominio principal.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www -> sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /index.html -> / (una sola URL para la home)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

  # --- URLs sin extension para las paginas de servicio --------------------
  # Sirve /gohighlevel desde gohighlevel.html. La condicion -f es lo que lo
  # hace seguro: solo reescribe cuando el .html existe de verdad, asi que no
  # se come el 404 ni interfiere con nada. Las paginas de servicio que se
  # agreguen despues funcionan sin tocar esta regla.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # Y al reves, para que exista UNA sola URL indexable: gohighlevel.html
  # redirige a /gohighlevel. Las paginas se listan una por una a proposito:
  # una regla generica arrastraria tambien privacy.html y terms.html, cuyas
  # URLs con extension ya estan indexadas y en el sitemap. Al crear una
  # pagina de servicio hay que sumarla aqui; check-seo.sh avisa si falta.
  RewriteCond %{THE_REQUEST} \s/+(gohighlevel|agente-de-voz-ia|agentes-ia-whatsapp)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# --- 2. Pagina 404 propia --------------------------------------------------
ErrorDocument 404 /404.html

# --- 3. Compresion ---------------------------------------------------------
# El HTML pesa ~93 KB; comprimido baja a ~15 KB. Impacto directo en LCP.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 4. Cache del navegador ------------------------------------------------
# HTML sin cache: el sitio se sube a mano, un cambio debe verse al instante.
# Imagenes 30 dias: si reemplazas un archivo, se refresca en un plazo razonable.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 30 days"
  ExpiresByType application/javascript    "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- 5. Cabeceras de seguridad ------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # HSTS: fuerza https durante 1 anio en el navegador del visitante.
  # Descomenta SOLO si el certificado SSL nunca va a faltar; si el sitio
  # queda sin https, los visitantes recurrentes no podran entrar.
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- 6. Archivos internos fuera del alcance publico ------------------------
# En public_html conviven archivos de desarrollo (CLAUDE.md, README.md,
# flammeta.json.template). Todo lo que esta en el document root lo sirve el
# servidor salvo que se bloquee, y esos documentos describen la arquitectura
# y el flujo de la llamada de voz. Mejor que no sean legibles desde fuera.
# Se usa RedirectMatch (mod_alias) en vez de <FilesMatch>+Require: una sola
# mecanica, sin depender del proveedor de autorizacion, y si el modulo
# faltara no tumba el sitio con un 500.
<IfModule mod_alias.c>
  RedirectMatch 404 \.(md|markdown|template|yml|yaml|ini|log|sh|bak|sql)$

  # Archivos ocultos (.git, .env, .DS_Store...), con .well-known como
  # excepcion porque lo usan los certificados y la verificacion de dominio.
  RedirectMatch 404 /\.(?!well-known)
</IfModule>

# --- 7. Sin listado de directorios ----------------------------------------
Options -Indexes
